{{define "main"}}
    <div class="content">
        <h1>God Tools</h1>
        <a class="pure-button pure-button-primary"
           href="/api/internal/update-master-db">
            Pull Master Database From Bluebot Server (Disabled, only pulls from local directory)
        </a>

        <br>
        <br>

        <form action="/api/internal/recompute-submission-cache-all" method="POST">
            <button type="submit" class="pure-button pure-button-primary">Recompute Submission Cache</button>
        </form>

        <br>
        <br>

        <form class="pure-form pure-form-stacked" action="/api/internal/delete-user-sessions" method="POST">
            <label for="discord-user-id">Discord User ID</label>
            <input type="text" name="discord-user-id" value="" size="32">
            <button type="submit" class="pure-button button-delete">Delete user's sessions</button>
        </form>

        <form class="pure-form pure-form-stacked" action="/api/internal/approve-submission" method="POST">
            <label for="submission-id">Submission ID</label>
            <input type="text" name="submission-id" value="" size="32">
            <button type="submit" class="pure-button button-approve">Force Approve Submission</button>
        </form>

        <form class="pure-form pure-form-stacked" action="/api/internal/verify-submission" method="POST">
            <label for="submission-id">Submission ID</label>
            <input type="text" name="submission-id" value="" size="32">
            <button type="submit" class="pure-button button-approve">Force Verify Submission</button>
        </form>

        <br>
        <br>

        <form action="/api/internal/send-reminders-about-requested-changes" method="POST">
            <button type="submit" class="pure-button pure-button-primary">
                Send Reminders About Submissions With Requested Changes
            </button>
        </form>

        <br>
        <br>

        <form action="/api/internal/nuke-session-table" method="POST">
            <button type="submit" class="pure-button button-delete">Nuke Session Table</button>
        </form>
    </div>
{{end}}
