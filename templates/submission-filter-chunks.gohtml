{{define "submission-filter-additional-meta"}}
    <div class="form-column">
        <fieldset class="additional-metadata-filter">
            <legend>Additional Metadata Filters</legend>
            <p class="additional-metadata-help">Text fields: partial, case-insensitive. Tags: comma-separated includes (match any); ! excludes.</p>
            <div class="additional-metadata-grid">
                <label for="series-partial">Series
                    <input id="series-partial" name="series-partial" type="text" value="{{default "" .Filter.SeriesPartial}}">
                </label>
                <label for="developer-partial">Developer
                    <input id="developer-partial" name="developer-partial" type="text" value="{{default "" .Filter.DeveloperPartial}}">
                </label>
                <label for="publisher-partial">Publisher
                    <input id="publisher-partial" name="publisher-partial" type="text" value="{{default "" .Filter.PublisherPartial}}">
                </label>
                <label for="tags-partial">Tags
                    <input id="tags-partial" name="tags-partial" type="text" value="{{default "" .Filter.TagsPartial}}" placeholder="puzzle, arcade, !adult">
                </label>
                <label for="play-mode-partial">Play Mode
                    <input id="play-mode-partial" name="play-mode-partial" type="text" value="{{default "" .Filter.PlayModePartial}}">
                </label>
                <label for="status-partial">Status
                    <input id="status-partial" name="status-partial" type="text" value="{{default "" .Filter.StatusPartial}}">
                </label>
                <label for="version-partial">Version
                    <input id="version-partial" name="version-partial" type="text" value="{{default "" .Filter.VersionPartial}}">
                </label>
                <label for="release-date-partial">Release Date
                    <input id="release-date-partial" name="release-date-partial" type="text" value="{{default "" .Filter.ReleaseDatePartial}}" placeholder="e.g. 2004 or 2004-06">
                </label>
                <label for="language-partial">Language
                    <input id="language-partial" name="language-partial" type="text" value="{{default "" .Filter.LanguagePartial}}">
                </label>
                <label for="source-partial">Source
                    <input id="source-partial" name="source-partial" type="text" value="{{default "" .Filter.SourcePartial}}">
                </label>
                <div>
                    <label for="has-additional-applications">Additional Applications</label>
                    <select id="has-additional-applications" name="has-additional-applications">
                        <option value="">Any</option>
                        <option value="yes" {{if eq "yes" (unpointify .Filter.HasAdditionalApplications)}}selected{{end}}>Has any</option>
                        <option value="no" {{if eq "no" (unpointify .Filter.HasAdditionalApplications)}}selected{{end}}>Has none</option>
                    </select>
                </div>
            </div>
            <div class="additional-metadata-grid">
                <label for="game-notes-partial">Game Notes
                    <input id="game-notes-partial" name="game-notes-partial" type="text" value="{{default "" .Filter.GameNotesPartial}}">
                </label>
                <label for="curation-notes-partial">Curation Notes
                    <input id="curation-notes-partial" name="curation-notes-partial" type="text" value="{{default "" .Filter.CurationNotesPartial}}">
                </label>
                <label for="original-description-partial">Original Description
                    <input id="original-description-partial" name="original-description-partial" type="text" value="{{default "" .Filter.OriginalDescriptionPartial}}">
                </label>
            </div>
        </fieldset>
    </div>
{{end}}
{{define "submission-filter-type"}}
    <fieldset>
        <legend>Filter by type</legend>
        <div class="pure-g">
            <div class="pure-u-1-2">
                <label>
                    <input type="radio" name="is-content-change" value="no"
                           {{if eq "no" (unpointify .Filter.IsContentChange)}}checked{{end}}>
                    Curation</label>
            </div>
            <div class="pure-u-1-2">
                <label>
                    <input type="radio" name="is-content-change" value="yes"
                           {{if eq "yes" (unpointify .Filter.IsContentChange)}}checked{{end}}>
                    Content Change</label>
            </div>
        </div>
    </fieldset>
{{end}}
{{define "submission-filter-maturity"}}
    <fieldset>
        <legend>Filter by maturity</legend>
        <div class="pure-g">
            <div class="pure-u-1-2">
                <label>
                    <input type="radio" name="is-extreme" value="no"
                           {{if eq "no" (unpointify .Filter.IsExtreme)}}checked{{end}}>
                    Not Extreme</label>
            </div>
            <div class="pure-u-1-2">
                <label>
                    <input type="radio" name="is-extreme" value="yes"
                           {{if eq "yes" (unpointify .Filter.IsExtreme)}}checked{{end}}>
                    Extreme</label>
            </div>
        </div>
    </fieldset>
{{end}}
{{define "submission-filter-frozen"}}
    <fieldset>
        <legend>Filter by temperature</legend>
        <div class="pure-g">
            <div class="pure-u-1-2">
                <label>
                    <input type="radio" name="is-frozen" value="no"
                           {{if eq "no" (unpointify .Filter.IsFrozen)}}checked{{end}}>
                    Not Frozen</label>
            </div>
            <div class="pure-u-1-2">
                <label>
                    <input type="radio" name="is-frozen" value="yes"
                           {{if eq "yes" (unpointify .Filter.IsFrozen)}}checked{{end}}>
                    Frozen</label>
            </div>
        </div>
    </fieldset>
{{end}}
{{define "submission-filter-level"}}
    <fieldset>
        <legend>Filter by Submission Level (union)</legend>
        <div class="pure-g">
            <div class="pure-u-1-3">
                <label for="sumbission-level">
                    <input type="checkbox" name="sumbission-level" value="audition"
                           {{if has "audition" .Filter.SubmissionLevels}}checked{{end}}>
                    Audition</label>
            </div>
            <div class="pure-u-1-3">
                <label for="sumbission-level">
                    <input type="checkbox" name="sumbission-level" value="trial"
                           {{if has "trial" .Filter.SubmissionLevels}}checked{{end}}>
                    Trial</label>
            </div>
            <div class="pure-u-1-3">
                <label for="sumbission-level">
                    <input type="checkbox" name="sumbission-level" value="staff"
                           {{if has "staff" .Filter.SubmissionLevels}}checked{{end}}>
                    Staff</label>
            </div>
        </div>
    </fieldset>
{{end}}
{{define "submission-filter-bot-actions"}}
    <fieldset>
        <legend>Filter by Bot Actions (union)</legend>
        <div class="pure-g">
            <div class="pure-u-1-2">
                <label for="bot-action">
                    <input type="checkbox" name="bot-action" value="approve"
                           class="bot-action-approve"
                           {{if has "approve" .Filter.BotActions}}checked{{end}}>
                    Bot Happy :D</label>
            </div>
            <div class="pure-u-1-2">
                <label for="bot-action">
                    <input type="checkbox" name="bot-action" value="request-changes"
                           class="bot-action-request-changes"
                           {{if has "request-changes" .Filter.BotActions}}checked{{end}}>
                    Bot Sad :C</label>
            </div>
        </div>
    </fieldset>
{{end}}
{{define "submission-filter-basic-meta"}}
    <div class="form-column-text">
        <label for="title-partial">Title (partial)</label>
        <input type="text" name="title-partial" value="{{default "" .Filter.TitlePartial}}">
        <label for="platform-partial"
               title="Type comma-separated platform names (substrings) to search, prepend with '!' to exclude a substring. For example, write '!flash, !unity' to exclude flash and unity platforms. The search is case-insensitive.">Platform
            (hover for help)</label>
        <input type="text" list="platforms" name="platform-partial"
               value="{{default "" .Filter.PlatformPartial}}">
        <datalist id="platforms">
            <option value="3D Groove">
            <option value="3DVIA">
